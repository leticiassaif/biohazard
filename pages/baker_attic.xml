<page id="baker_attic" bg_image="attic_1.png">

<fab-if when="narrative_attic = 0"> 
  <agent 
    id="attic_message_1"
    x="50"
    y="230"
    text="Você sobe as escadas, agora com a mão amputada, e aberta no botão. Ele funciona e aparece uma outra escada que leva para o sótão."
    color="white"
    font-size="20"
    width="700"
    animation="fade-in-down"
    />

  <agent 
    id="attic_button_1"
    x="center"
    y="340"
    border="dotted"
    border_color="black"
    text="clique aqui para subir as escadas"
    radius="16"
    width="400"
    animation="hover-bg-color-[#8da56a]"
    on_click="set(narrative_attic, $narrative_attic + 1)"
    />
</fab-if>

<fab-if when="narrative_attic = 1"> 
  <agent 
    id="attic_upstairs_1"
    x="center"
    y="center"
    image="attic_2.png"
    width="1100"
    animation="fade-in"
    />
  
  <agent 
    id="attic_message_2"
    x="50"
    y="230"
    text="Explorando a parte de cima, você encontra uma pistola e munição para ela. Algo te diz que você vai realmente precisar disso se quiser sair vivo."
    color="white"
    font-size="20"
    width="700"
    animation="fade-in-down"
    />

  <agent 
    id="attic_button_2"
    x="center"
    y="340"
    border="dotted"
    border_color="black"
    text="clique aqui para continuar explorando"
    radius="16"
    width="400"
    animation="hover-bg-color-[#8da56a]"
    on_click="set(narrative_attic, $narrative_attic + 1)"
    />
</fab-if>

<fab-if when="narrative_attic = 2"> 
  <agent 
    id="attic_upstairs_2"
    x="center"
    y="center"
    image="attic_3.png"
    width="1100"
    animation="fade-in"
    />
  
  <agent 
    id="attic_message_3"
    x="50"
    y="230"
    text="Explorando a parte de cima, você encontra uma pistola e munição para ela. Algo te diz que você vai realmente precisar disso se quiser sair vivo."
    color="white"
    font-size="20"
    width="700"
    animation="fade-in-down"
    />

  <agent 
    id="attic_button_3"
    x="center"
    y="340"
    border="dotted"
    border_color="black"
    text="clique aqui para continuar explorando"
    radius="16"
    width="400"
    animation="hover-bg-color-[#8da56a]"
    on_click="set(narrative_attic, $narrative_attic + 1)"
    />
</fab-if>
  
</page>