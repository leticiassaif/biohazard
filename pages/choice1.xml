<page id="choice1" bg_color="black">

  <agent
    id="choice1_ending1"
    text="Começar a busca."
    y="330"
    x="80"
    font-size="25"
    color="white"
    radius="16"
    width="270"
    on_click="goToPage('baker_outside'); set(coragem, $coragem + 20)"
    animation="hover-bg-color-[gray] hover-color-[white]"
  />

  <agent
    id="choice2_ending1"
    text="Ficar longe."
    y="330"
    x="530"
    font-size="25"
    color="white"
    width="200"
    radius="16"
    animation="hover-bg-color-[gray] hover-color-[white]"
    on_click="goToPage('ending_giveup'); set(coragem, $coragem - 30); set(sanidade, $sanidade - 20)"
  />

  <agent
    id="choice_message"
    text="Faça uma escolha."
    y="220"
    x="230"
    font-size="30"
    color="white"
    animation="fade-in-down"
    border_color="white"
    border="dashed"
    radius="16"
    width="340"
  />
  
</page>